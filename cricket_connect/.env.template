# Environment variables for Cricket Connect

# Backend Configuration
PYTHON_ENV="development" # or "production", "test"
SECRET_KEY="your-super-secret-and-long-random-string" # IMPORTANT: Change this in production!
ALGORITHM="HS256" # Algorithm for JWT
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database (Example for PostgreSQL)
# DATABASE_URL="postgresql://user:password@host:port/dbname"

# Redis (Example)
# REDIS_HOST="localhost"
# REDIS_PORT=6379

# Cricket API Configuration
# Replace with your actual API provider's details.
# Example for a RapidAPI source (ensure these match your chosen API):
CRICKET_API_KEY="your_rapidapi_key_here"
CRICKET_API_BASE_URL="https://cricket-live-scores-api.p.rapidapi.com" # Example base URL
CRICKET_API_HOST="cricket-live-scores-api.p.rapidapi.com" # Example RapidAPI host header value

# AI Services Configuration (Optional)
# OPENAI_API_KEY="your_openai_api_key"

# Sentry DSN for error tracking (Optional)
# SENTRY_DSN="your_sentry_dsn_here"
